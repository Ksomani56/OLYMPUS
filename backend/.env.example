# TrustFed Backend Environment Variables
# Copy this file to .env and set your Google Gemini API key.
# IMPORTANT: Never commit your real .env file or expose the API key to frontend code.

GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Comma-separated allowed browser origins for CORS
FRONTEND_ORIGINS="http://localhost:3000,http://localhost:5173"
